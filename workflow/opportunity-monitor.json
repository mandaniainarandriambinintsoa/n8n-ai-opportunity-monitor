              "id": "score_reasons",
              "displayName": "score_reasons",
              "type": "string"
            },
            {
              "id": "categories",
              "displayName": "categories",
              "type": "string"
            },
            {
              "id": "budget_label",
              "displayName": "budget_label",
              "type": "string"
